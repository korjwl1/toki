FROM rust:1.92-slim-bookworm AS builder
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY toki_sync/Cargo.toml toki_sync/Cargo.lock ./
COPY toki_sync/src ./src
COPY toki_sync/static ./static
RUN cargo build --release && cp target/release/toki-sync /build/toki-sync

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 wget curl && \
    rm -rf /var/lib/apt/lists/* && groupadd -r toki && useradd -r -g toki toki
COPY --from=builder /build/toki-sync /usr/local/bin/toki-sync
RUN mkdir -p /data && chown toki:toki /data
USER toki
EXPOSE 9090 9091
ENTRYPOINT ["/usr/local/bin/toki-sync"]
